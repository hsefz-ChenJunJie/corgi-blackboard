<UserControl x:Class="CorgiBlackboard.App.Views.BoardSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:CorgiBlackboard.App.Rendering"
             Background="Black" Focusable="True"
             Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False">
  <!-- The black grid is the hit-test surface; committed and transient ink share one camera translation. -->
  <Grid Background="Black" ClipToBounds="True">
    <Canvas IsHitTestVisible="False">
      <Canvas.RenderTransform>
        <TranslateTransform x:Name="CameraTranslation" />
      </Canvas.RenderTransform>
      <rendering:CommittedInkLayer x:Name="CommittedInk" />
      <rendering:TransientInkLayer x:Name="TransientInk" />
    </Canvas>
  </Grid>
</UserControl>
