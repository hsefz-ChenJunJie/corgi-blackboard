<UserControl x:Class="CorgiBlackboard.App.Documents.ImageWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:documents="clr-namespace:CorgiBlackboard.App.Documents"
             Focusable="False" ClipToBounds="True">
  <Grid Background="#4A5664">
    <Border x:Name="Frame" Margin="8" Background="#20242B">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="#283745">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <documents:DocumentRegion x:Name="TitleGrip" Background="Transparent" Cursor="SizeAll">
            <TextBlock x:Name="TitleText" Foreground="White" VerticalAlignment="Center"
                       Margin="8,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
          </documents:DocumentRegion>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="MinimizeButton" Content="—" ToolTip="最小化资料"
                    Width="44" Height="44" MinWidth="44" MinHeight="44" Margin="0" Padding="0" />
            <ToggleButton x:Name="FillButton" Content="铺满" ToolTip="铺满或返回普通窗口"
                          Width="44" Height="44" MinWidth="44" MinHeight="44" Margin="0" Padding="0" />
            <Button x:Name="CloseButton" Content="×" ToolTip="关闭资料"
                    Width="44" Height="44" MinWidth="44" MinHeight="44" Margin="0" Padding="0" />
          </StackPanel>
        </Grid>
        <documents:DocumentRegion Grid.Row="1" x:Name="ContentSlot" Background="#121619" ClipToBounds="True" />
      </Grid>
    </Border>
    <Grid x:Name="ResizeEdges">
      <documents:DocumentRegion x:Name="ResizeN" Height="8" VerticalAlignment="Top" Margin="8,0" Background="Transparent" Cursor="SizeNS" />
      <documents:DocumentRegion x:Name="ResizeS" Height="8" VerticalAlignment="Bottom" Margin="8,0" Background="Transparent" Cursor="SizeNS" />
      <documents:DocumentRegion x:Name="ResizeW" Width="8" HorizontalAlignment="Left" Margin="0,8" Background="Transparent" Cursor="SizeWE" />
      <documents:DocumentRegion x:Name="ResizeE" Width="8" HorizontalAlignment="Right" Margin="0,8" Background="Transparent" Cursor="SizeWE" />
      <documents:DocumentRegion x:Name="ResizeNW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" />
      <documents:DocumentRegion x:Name="ResizeNE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" />
      <documents:DocumentRegion x:Name="ResizeSW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" />
      <documents:DocumentRegion x:Name="ResizeSE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" />
    </Grid>
  </Grid>
</UserControl>
